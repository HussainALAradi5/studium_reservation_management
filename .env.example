APP_NAME=Studium
# production: APP_ENV=production and APP_DEBUG=false
APP_ENV=development
APP_DEBUG=true
# true when HTTPS is terminated by a proxy in front of PHP (InfinityFree, Cloudflare, Render)
APP_TRUST_PROXY=false
APP_TIMEZONE=Asia/Bahrain
APP_CURRENCY=BHD
# Leave empty to auto-detect from the script path (e.g. /studium_reservation_management)
APP_BASE_PATH=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=studium_reservation_management
DB_USER=root
DB_PASS=

SESSION_IDLE_MINUTES=120

MAP_DEFAULT_LAT=26.0667
MAP_DEFAULT_LNG=50.5577
MAP_DEFAULT_ZOOM=11
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Development seed only: password for the seeded admin, manager and customer users
SEED_PASSWORD=
